{% assign author_name = site.first_name | append: ' ' | append: site.last_name %}
{% assign meta_description = page.description | default: site.description | strip_html | strip_newlines | strip %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign social_image = page.og_image | default: site.og_image | absolute_url %}
{% assign current_cv_entry = site.data.cv.experience | where: 'current', true | first %}
{% assign current_role = site.current_position.role | default: current_cv_entry.role | default: 'Distinguished Engineer' %}
{% assign current_organisation = site.current_position.organisation | default: current_cv_entry.organisation | default: 'NVIDIA' %}
{% assign current_organisation_url = site.current_position.organisation_url
  | default: current_cv_entry.organisation_url
  | default: 'https://www.nvidia.com/'
%}
{% if page.permalink == '/' %}
  {% assign meta_title = site.title %}
{% else %}
  {% assign meta_title = page.title | append: ' | ' | append: site.title %}
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta_title | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
<meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% if page.robots %}<meta name="robots" content="{{ page.robots }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ site.title | escape }}">
  <meta property="og:type" content="{{ page.og_type | default: 'website' }}">
  <meta property="og:title" content="{{ meta_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  <meta property="og:image" content="{{ social_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Neil Ashton — AI for computational engineering and CFD research">
  <meta property="og:locale" content="en_GB">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ meta_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  <meta name="twitter:image" content="{{ social_image }}">
  <meta name="twitter:image:alt" content="Neil Ashton — AI for computational engineering and CFD research">
{% endif %}

{% if site.serve_schema_org %}
  {% if page.schema_type == 'ProfilePage' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": {{ canonical_url | jsonify }},
        "name": {{ meta_title | jsonify }},
        "description": {{ meta_description | jsonify }},
        "mainEntity": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }},
          "image": {{ '/assets/img/prof_pic.jpg' | absolute_url | jsonify }},
          "jobTitle": {{ current_role | jsonify }},
          "worksFor": {
            "@type": "Organization",
            "name": {{ current_organisation | jsonify }},
            "url": {{ current_organisation_url | jsonify }}
          },
          "sameAs": {{ site.same_as | jsonify }}
        }
      }
    </script>
  {% elsif page.schema_type == 'PodcastSeries' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "PodcastSeries",
        "name": "The Neil Ashton Podcast",
        "url": {{ canonical_url | jsonify }},
        "description": {{ meta_description | jsonify }},
        "author": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }}
        },
        "sameAs": {{ page.podcast_same_as | jsonify }}
      }
    </script>
  {% else %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": {{ canonical_url | jsonify }},
        "name": {{ meta_title | jsonify }},
        "description": {{ meta_description | jsonify }},
        "author": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }}
        }
      }
    </script>
  {% endif %}
{% endif %}

{% assign author_name = site.first_name | append: ' ' | append: site.last_name %}
{% assign meta_description = page.description | default: site.description | strip_html | strip_newlines | strip %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign social_image = page.og_image | default: site.og_image | absolute_url %}
{% assign social_image_alt = page.og_image_alt | default: site.og_image_alt | default: 'Neil Ashton — Computational Engineering' %}
{% assign social_image_width = page.og_image_width | default: 1200 %}
{% assign social_image_height = page.og_image_height | default: 630 %}
{% assign current_role = site.current_position.role %}
{% assign current_organisation = site.current_position.organisation %}
{% assign current_organisation_url = site.current_position.organisation_url %}
{% if page.meta_title %}
  {% assign meta_title = page.meta_title %}
{% elsif page.permalink == '/' %}
  {% assign meta_title = site.homepage_meta_title | default: site.title %}
{% else %}
  {% assign meta_title = page.title | append: ' | ' | append: site.title %}
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta_title | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
<meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% if page.robots %}<meta name="robots" content="{{ page.robots }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if site.podcast_rss_url %}
  <link rel="alternate" type="application/rss+xml" title="The Neil Ashton Podcast" href="{{ site.podcast_rss_url }}">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ site.title | escape }}">
  <meta property="og:type" content="{{ page.og_type | default: 'website' }}">
  <meta property="og:title" content="{{ meta_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  <meta property="og:image" content="{{ social_image }}">
  <meta property="og:image:width" content="{{ social_image_width }}">
  <meta property="og:image:height" content="{{ social_image_height }}">
  <meta property="og:image:alt" content="{{ social_image_alt | escape }}">
  <meta property="og:locale" content="en_GB">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ meta_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  <meta name="twitter:image" content="{{ social_image }}">
  <meta name="twitter:image:alt" content="{{ social_image_alt | escape }}">
{% endif %}

{% if site.serve_schema_org %}
  {% if page.schema_type == 'ProfilePage' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": {{ canonical_url | jsonify }},
        "name": {{ meta_title | jsonify }},
        "description": {{ meta_description | jsonify }},
        "mainEntity": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }},
          "image": {{ '/assets/img/prof_pic.jpg' | absolute_url | jsonify }},
          "jobTitle": {{ current_role | jsonify }},
          "worksFor": {
            "@type": "Organization",
            "name": {{ current_organisation | jsonify }},
            "url": {{ current_organisation_url | jsonify }}
          },
          "sameAs": {{ site.same_as | jsonify }}
        }
      }
    </script>
  {% elsif page.schema_type == 'PodcastSeries' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "PodcastSeries",
        "name": "The Neil Ashton Podcast",
        "url": {{ canonical_url | jsonify }},
        "description": {{ meta_description | jsonify }},
        "webFeed": {{ site.podcast_rss_url | jsonify }},
        "author": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }}
        },
        "sameAs": {{ page.podcast_same_as | jsonify }}
      }
    </script>
  {% elsif page.schema_type == 'PodcastEpisode' %}
    {% assign publication_date = page.date | date_to_xmlschema %}
    {% assign episode_image = page.episode_image | absolute_url %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "PodcastEpisode",
        "name": {{ page.title | jsonify }},
        "url": {{ canonical_url | jsonify }},
        "description": {{ meta_description | jsonify }},
        "datePublished": {{ publication_date | jsonify }},
        "duration": {{ page.duration_iso | jsonify }},
        "episodeNumber": {{ page.episode | jsonify }},
        "image": {{ episode_image | jsonify }},
        "author": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }}
        },
        "partOfSeason": {
          "@type": "PodcastSeason",
          "seasonNumber": {{ page.season | jsonify }},
          "partOfSeries": {
            "@type": "PodcastSeries",
            "name": "The Neil Ashton Podcast",
            "url": {{ '/podcasts/' | absolute_url | jsonify }},
            "webFeed": {{ site.podcast_rss_url | jsonify }}
          }
        },
        "associatedMedia": {
          "@type": "MediaObject",
          "contentUrl": {{ page.audio_url | jsonify }},
          "encodingFormat": "audio/mpeg"
        },
        "sameAs": [
          {{ page.spotify_url | jsonify }},
          {{ page.creator_url | jsonify }}
        ]
      }
    </script>
  {% else %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": {{ canonical_url | jsonify }},
        "name": {{ meta_title | jsonify }},
        "description": {{ meta_description | jsonify }},
        "author": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | jsonify }}
        }
      }
    </script>
  {% endif %}
{% endif %}

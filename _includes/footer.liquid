<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">Neil Ashton</p>
      <p>Computational Engineering</p>
    </div>
    <nav class="footer-links" aria-label="Footer links">
      <a href="{{ '/cv/' | relative_url }}">CV</a>
      <a href="mailto:{{ site.email | encode_email }}">Email</a>
      <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn</a>
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
      <a href="https://orcid.org/{{ site.orcid_id }}">ORCID</a>
      <a href="{{ '/privacy/' | relative_url }}">Privacy</a>
      {% if site.enable_google_analytics -%}
        <button class="footer-link-button" type="button" data-analytics-settings>Analytics settings</button>
      {%- endif %}
    </nav>
    <p class="footer-meta">&copy; {{ site.time | date: '%Y' }} Neil Ashton. Built with Jekyll and hosted on GitHub Pages.</p>
  </div>
</footer>

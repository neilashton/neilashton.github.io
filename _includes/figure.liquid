{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
<figure
  {% if include.class %}
    class="{{ include.class }}"
  {% endif %}
>
  <picture>
    {% if site.imagemagick.enabled %}
      <source
        srcset="{% for width in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ width }}.webp {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
        sizes="{{ include.sizes | default: '100vw' }}"
        type="image/webp"
      >
    {% endif %}
    <img
      src="{{ include.path | relative_url }}"
      alt="{{ include.alt | default: '' }}"
      {% if include.img_class %}
        class="{{ include.img_class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      decoding="async"
    >
  </picture>
  {% if include.caption %}
    <figcaption>{{ include.caption }}</figcaption>
  {% endif %}
</figure>

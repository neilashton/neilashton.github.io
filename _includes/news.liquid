<div class="news-list">
  {% if site.news != blank %}
    {% assign ordered_news = site.news | sort: 'date' | reverse %}
    {% assign news_size = ordered_news | size %}
    {% if include.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <ol>
      {% for item in ordered_news limit: news_limit %}
        <li>
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%d %b %Y' }}</time>
          <div class="news-content">{{ item.content }}</div>
        </li>
      {% endfor %}
    </ol>
    {% if include.limit and news_size > news_limit %}
      <a class="text-link news-more" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">→</span></a>
    {% endif %}
  {% else %}
    <p>No updates yet.</p>
  {% endif %}
</div>

---
---
{% assign primary_url = null %}
{% if entry.html %}
  {% if entry.html contains '://' %}
    {% assign primary_url = entry.html %}
  {% else %}
    {% assign primary_url = entry.html | prepend: '/assets/html/' | relative_url %}
  {% endif %}
{% elsif entry.doi %}
  {% assign primary_url = entry.doi | prepend: 'https://doi.org/' %}
{% elsif entry.url %}
  {% assign primary_url = entry.url %}
{% elsif entry.arxiv %}
  {% assign primary_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
{% elsif entry.pdf %}
  {% if entry.pdf contains '://' %}
    {% assign primary_url = entry.pdf %}
  {% else %}
    {% assign primary_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

<article id="{{ entry.key }}" class="publication-entry" data-publication-entry>
  {% if site.enable_publication_thumbnails and entry.preview %}
    <div class="publication-media" aria-hidden="true">
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="" width="160" height="96" loading="lazy" decoding="async">
      {% else %}
        {% assign preview_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% assign preview_base = entry.preview | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
        <picture>
          <source
            srcset="{{ preview_base | prepend: '/assets/img/publication_preview/' | append: '-200.webp' | relative_url }} 200w, {{ preview_base | prepend: '/assets/img/publication_preview/' | append: '-400.webp' | relative_url }} 400w"
            sizes="(min-width: 640px) 160px, 96px"
            type="image/webp"
          >
          <img src="{{ preview_path | relative_url }}" alt="" width="160" height="96" loading="lazy" decoding="async">
        </picture>
      {% endif %}
    </div>
  {% endif %}

  <div class="publication-body">
    <h3 class="publication-title">
      {% if primary_url %}
        <a href="{{ primary_url }}">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h3>

    <div class="publication-authors">
      {% assign author_count = entry.author_array | size %}
      {% assign visible_author_count = author_count %}
      {% if site.max_author_limit and author_count > site.max_author_limit %}
        {% assign visible_author_count = site.max_author_limit %}
      {% endif %}

      <span>
        {% for author in entry.author_array limit: visible_author_count %}
          {% assign clean_last_name = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' %}
          {% assign author_is_self = false %}
          {% if clean_last_name == 'Ashton' %}
            {% if author.first == 'Neil' or author.first == 'N.' or author.first == 'N' %}
              {% assign author_is_self = true %}
            {% endif %}
          {% endif %}
          {% unless forloop.first %}, {% endunless %}
          {% if author_is_self -%}
            <strong class="author-self">
              {{- author.first }}
              {{ clean_last_name -}}
            </strong>
          {%- else -%}
            {{- author.first }}
            {{ clean_last_name -}}
          {%- endif %}
        {% endfor %}
      </span>

      {% assign hidden_author_count = author_count | minus: visible_author_count %}
      {% if hidden_author_count > 0 %}
        <details class="more-authors">
          <summary>
            {{ hidden_author_count }} more author{% if hidden_author_count != 1 %}s{% endif %}
          </summary>
          <span>
            {% for author in entry.author_array offset: visible_author_count %}
              {% unless forloop.first %}, {% endunless -%}
              {{- author.first }}
              {{ author.last }}
            {% endfor %}
          </span>
        </details>
      {% endif %}
    </div>

    {% assign proceedings_types = 'inproceedings,incollection,inbook,conference' | split: ',' %}
    {% assign thesis_types = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    <p class="publication-venue">
      {% if entry.type == 'article' and entry.journal -%}
        <em>{{ entry.journal }}</em>
      {%- endif %}
      {% if proceedings_types contains entry.type and entry.booktitle -%}
        <em>{{ entry.booktitle }}</em>
      {%- endif %}
      {% if thesis_types contains entry.type and entry.school -%}
        <em>{{ entry.school }}</em>
      {%- endif %}
      {% if entry.note -%}
        <span>{{ entry.note }}</span>
      {%- endif %}
      {% if entry.year -%}
        <span class="publication-year">{{ entry.year }}</span>
      {%- endif %}
    </p>

    <div class="publication-links" role="group" aria-label="Links for {{ entry.title | strip_html | escape }}">
      {% if primary_url %}
        <a class="publication-button" href="{{ primary_url }}">Paper</a>
      {% endif %}
      {% if entry.abstract %}
        <button
          class="publication-button"
          type="button"
          data-disclosure-target="abstract-{{ entry.key }}"
          aria-controls="abstract-{{ entry.key }}"
          aria-expanded="false"
        >
          Abstract
        </button>
      {% endif %}
      {% if entry.bibtex_show %}
        <button
          class="publication-button"
          type="button"
          data-disclosure-target="bibtex-{{ entry.key }}"
          aria-controls="bibtex-{{ entry.key }}"
          aria-expanded="false"
        >
          BibTeX
        </button>
      {% endif %}
      {% if entry.code -%}
        <a class="publication-button" href="{{ entry.code }}">Code</a>
      {%- endif %}
      {% if entry.website -%}
        <a class="publication-button" href="{{ entry.website }}">Website</a>
      {%- endif %}
      {% if entry.supp %}
        {% if entry.supp contains '://' -%}
          {%- assign supp_url = entry.supp -%}
        {%- else -%}
          {%- assign supp_url = entry.supp | prepend: '/assets/pdf/' | relative_url -%}
        {%- endif %}
        <a class="publication-button" href="{{ supp_url }}">Supplement</a>
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' -%}
          {%- assign poster_url = entry.poster -%}
        {%- else -%}
          {%- assign poster_url = entry.poster | prepend: '/assets/pdf/' | relative_url -%}
        {%- endif %}
        <a class="publication-button" href="{{ poster_url }}">Poster</a>
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' -%}
          {%- assign slides_url = entry.slides -%}
        {%- else -%}
          {%- assign slides_url = entry.slides | prepend: '/assets/pdf/' | relative_url -%}
        {%- endif %}
        <a class="publication-button" href="{{ slides_url }}">Slides</a>
      {% endif %}
      {% if entry.video and entry.video contains '://' -%}
        <a class="publication-button" href="{{ entry.video }}">Video</a>
      {%- endif %}
    </div>

    {% if entry.abstract %}
      <div id="abstract-{{ entry.key }}" class="publication-disclosure" hidden>
        <h4>Abstract</h4>
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      <div id="bibtex-{{ entry.key }}" class="publication-disclosure" hidden>
        <h4>BibTeX</h4>
        <pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
      </div>
    {% endif %}
  </div>
</article>

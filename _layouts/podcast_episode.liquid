---
layout: default
---
{% capture episode_video_key %}s{{ page.season }}-e{{ page.episode }}{% endcapture %}
{% assign youtube_video = site.data.podcast_youtube[episode_video_key] %}
{% assign apple_episode_url = site.data.podcast_apple[episode_video_key] | default: site.apple_podcasts_url %}
{% assign episode_image_480 = page.episode_image | replace: '.webp', '-480.webp' %}
{% assign episode_image_768 = page.episode_image | replace: '.webp', '-768.webp' %}
<article class="podcast-episode">
  <nav class="episode-breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ '/podcasts/' | relative_url }}">Podcast</a>
    <span aria-hidden="true">/</span>
    <span>Season {{ page.season }}, episode {{ page.episode }}</span>
  </nav>

  <header class="episode-header">
    <div class="episode-header-copy">
      <p class="eyebrow">The Neil Ashton Podcast</p>
      <h1>{{ page.title | escape }}</h1>
      <p class="episode-meta">
        <span>Season {{ page.season }}, episode {{ page.episode }}</span>
        <span aria-hidden="true">·</span>
        <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time>
        <span aria-hidden="true">·</span>
        <span>{{ page.duration_display | escape }}</span>
      </p>
    </div>
    <img
      class="episode-artwork"
      src="{{ episode_image_480 | relative_url }}"
      srcset="{{ episode_image_480 | relative_url }} 480w, {{ episode_image_768 | relative_url }} 768w, {{ page.episode_image | relative_url }} 1280w"
      sizes="(max-width: 430px) calc(100vw - 30px), (max-width: 767px) 384px, 320px"
      alt="{{ page.episode_image_alt | escape }}"
      width="320"
      height="180"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  </header>

  {% if youtube_video %}
    <section class="episode-video" aria-labelledby="episode-video-title">
      <div class="episode-video-heading">
        <div>
          <p class="eyebrow">Watch on YouTube</p>
          <h2 id="episode-video-title">{{ page.title | escape }}</h2>
        </div>
        <a href="https://www.youtube.com/watch?v={{ youtube_video.id }}">Open on YouTube <span aria-hidden="true">↗</span></a>
      </div>
      <div
        class="podcast-video-frame episode-video-frame"
        data-youtube-video
        data-embed-src="https://www.youtube-nocookie.com/embed/{{ youtube_video.id }}?autoplay=1"
        data-embed-title="Watch {{ page.title | escape }} on YouTube"
      >
        <div class="podcast-video-slot" data-youtube-video-slot>
          <div class="podcast-video-poster">
            <img
              src="{{ episode_image_768 | relative_url }}"
              srcset="{{ episode_image_480 | relative_url }} 480w, {{ episode_image_768 | relative_url }} 768w, {{ page.episode_image | relative_url }} 1280w"
              sizes="(max-width: 959px) calc(100vw - 30px), 928px"
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            >
            <div class="podcast-video-poster-copy">
              <p class="eyebrow">YouTube video</p>
              <p class="podcast-video-poster-title">Watch this episode</p>
              <p>YouTube is contacted only after you choose to play the video, keeping this page fast and private by default.</p>
              <button
                class="button button-primary podcast-video-load"
                type="button"
                data-load-youtube-video
                aria-label="Play {{ page.title | escape }} on YouTube"
                hidden
              >
                Play episode
              </button>
              <noscript>
                <p class="podcast-video-noscript">
                  <a href="https://www.youtube.com/watch?v={{ youtube_video.id }}">Watch this episode on YouTube</a>.
                </p>
              </noscript>
            </div>
          </div>
        </div>
        <p class="sr-only" data-youtube-video-status aria-live="polite"></p>
      </div>
    </section>
  {% endif %}

  <p class="eyebrow episode-listen-label">Listen to the audio</p>
  <div
    class="podcast-embed podcast-embed--episode"
    data-podcast-embed
    data-embed-src="{{ page.spotify_embed_url }}"
    data-embed-title="{{ page.title | escape }} on Spotify"
    aria-label="{{ page.title | escape }} Spotify player"
  >
    <div class="podcast-embed-slot" data-podcast-embed-slot>
      <div class="podcast-embed-poster">
        <span class="podcast-embed-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" focusable="false">
            <circle cx="24" cy="24" r="23"></circle>
            <path d="m20 15 14 9-14 9Z"></path>
          </svg>
        </span>
        <div class="podcast-embed-copy">
          <p class="eyebrow">Spotify player</p>
          <p class="podcast-embed-title">{{ page.title | escape }}</p>
          <button
            class="button button-primary podcast-embed-load"
            type="button"
            data-load-podcast-player
            hidden
          >
            Load episode player
          </button>
          <noscript>
            <p class="podcast-embed-noscript">The embedded player requires JavaScript. You can still listen directly on Spotify.</p>
          </noscript>
        </div>
      </div>
    </div>
    <div class="podcast-embed-meta">
      <p>Spotify is contacted only after you load the player and may then set cookies.</p>
      <a href="{{ page.spotify_url }}">Open in Spotify <span aria-hidden="true">↗</span></a>
    </div>
    <p class="sr-only" data-podcast-embed-status aria-live="polite"></p>
  </div>

  <nav class="episode-platform-links academic-links" aria-label="Episode links">
    {% if youtube_video %}
      <a href="https://www.youtube.com/watch?v={{ youtube_video.id }}">YouTube</a>
    {% endif %}
    <a href="{{ page.spotify_url }}">Spotify</a>
    <a href="{{ page.creator_url }}">Spotify for Creators</a>
    <a href="{{ apple_episode_url }}">Apple Podcasts</a>
    {% if page.transcript_path %}
      <a href="{{ page.transcript_path | relative_url }}" download>Download transcript</a>
    {% endif %}
  </nav>

  <div class="episode-content">
    {{ content }}
  </div>

  {% assign related_episode_keys = site.data.podcast_related[episode_video_key] %}
  {% if related_episode_keys %}
    <section class="episode-related" aria-labelledby="related-episodes-title">
      <h2 id="related-episodes-title">Related episodes</h2>
      <div class="episode-related-grid">
        {% for related_key in related_episode_keys %}
          {% assign related_key_parts = related_key | split: '-' %}
          {% assign related_season = related_key_parts[0] | remove: 's' | plus: 0 %}
          {% assign related_episode_number = related_key_parts[1] | remove: 'e' | plus: 0 %}
          {% assign related_season_pages = site.podcast_episodes | where: 'season', related_season %}
          {% assign related_episode = related_season_pages | where: 'episode', related_episode_number | first %}
          {% if related_episode %}
            <article class="episode-related-card">
              <a href="{{ related_episode.url | relative_url }}">
                <img
                  src="{{ '/assets/img/podcast/episodes/' | append: related_key | append: '.webp' | relative_url }}"
                  alt=""
                  width="320"
                  height="180"
                  loading="lazy"
                  decoding="async"
                >
                <span class="episode-related-copy">
                  <span class="episode-related-meta">Season {{ related_season }}, episode {{ related_episode_number }}</span>
                  <span class="episode-related-title">{{ related_episode.title | escape }}</span>
                </span>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <nav class="episode-pagination" aria-label="Other podcast episodes">
    {% if page.older_url %}
      <a class="episode-pagination-link" href="{{ page.older_url | relative_url }}">
        <span class="episode-pagination-label">Older episode</span>
        <span>{{ page.older_title | escape }}</span>
      </a>
    {% endif %}
    {% if page.newer_url %}
      <a class="episode-pagination-link episode-pagination-link--next" href="{{ page.newer_url | relative_url }}">
        <span class="episode-pagination-label">Newer episode</span>
        <span>{{ page.newer_title | escape }}</span>
      </a>
    {% endif %}
  </nav>

  <p class="episode-archive-link"><a href="{{ '/podcasts/' | relative_url }}">Browse all podcast episodes →</a></p>
</article>

<script defer src="{{ '/assets/js/podcast-embed.js' | relative_url | bust_file_cache }}"></script>

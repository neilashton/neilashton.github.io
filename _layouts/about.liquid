---
layout: default
---
{% assign current_role = site.current_position.role %}
{% assign current_organisation = site.current_position.organisation %}
<article class="home-page">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{{ page.headline }}</h1>
      <p class="academic-position">{{ current_role | escape }}, {{ current_organisation | escape }}</p>
      <nav class="hero-social" aria-label="Contact and professional profiles">
        {% include social.liquid %}
      </nav>
    </div>
  </section>

  <section class="home-section about-section" aria-labelledby="about-title">
    <h2 id="about-title">Biography</h2>
    <div class="biography-layout">
      <div class="biography-copy">
        <div class="prose measure-wide">
          {{ content }}
        </div>
        <p class="cv-summary-links">
          <a class="text-link" href="{{ '/cv/' | relative_url }}">Curriculum vitae</a>
          <a class="text-link" href="{{ '/assets/pdf/neil-ashton-cv.pdf' | relative_url }}">Download PDF</a>
        </p>
      </div>
      <div class="hero-portrait biography-portrait">
        <div class="portrait-frame">
          <img
            src="{{ '/assets/img/neil-siggraph-2026-480.webp' | relative_url }}"
            alt="Neil Ashton speaking on stage at SIGGRAPH 2026"
            width="480"
            height="865"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </div>
      </div>
    </div>
  </section>

  <section class="home-section agenda-section" aria-labelledby="agenda-title">
    <div class="section-heading">
      <h2 id="agenda-title">Research agenda</h2>
    </div>
    <p class="section-intro measure-wide">My current research is organised around three connected questions.</p>
    <div class="research-agenda-list">
      {% for item in page.research_agenda %}
        <article>
          <h3>{{ item.title }}</h3>
          <p>{{ item.question }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section" aria-labelledby="featured-work-title">
    <div class="section-heading">
      <h2 id="featured-work-title">Current research</h2>
      <a class="text-link" href="{{ '/work/' | relative_url }}">Research overview</a>
    </div>
    <p class="section-intro measure-wide">
      Current work combines open scientific data, high-fidelity simulation, foundation models, and agentic engineering.
    </p>
    <div class="research-list">
      {% for item in page.featured_work %}
        <article class="research-item">
          <p class="research-type">{{ item.kicker }}</p>
          <div>
            <h3>
              <a href="{{ item.url }}">{{ item.title }}</a>
            </h3>
            <p>{{ item.description }}</p>
            <a class="text-link" href="{{ item.url }}">{{ item.link_label }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
    {% include workshop_leadership.liquid %}
  </section>

  {% assign latest_podcast_episodes = site.podcast_episodes | sort: 'date' | reverse %}
  {% if latest_podcast_episodes.size > 0 %}
    <section class="home-section" aria-labelledby="podcast-title">
      <div class="section-heading">
        <h2 id="podcast-title">Latest podcast episodes</h2>
        <a class="text-link" href="{{ '/podcasts/' | relative_url }}">All episodes</a>
      </div>
      <p class="section-intro measure-wide">
        Recent conversations about artificial intelligence, computational fluid dynamics, simulation, and engineering research.
      </p>
      <div class="home-podcast-grid">
        {% for episode in latest_podcast_episodes limit: 3 %}
          <article class="home-podcast-card">
            {% if episode.episode_image %}
              <img
                src="{{ episode.episode_image | relative_url }}"
                alt=""
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              >
            {% endif %}
            <p class="home-podcast-meta">
              Season {{ episode.season }} · Episode {{ episode.episode }} ·
              <time datetime="{{ episode.date | date_to_xmlschema }}">{{ episode.date | date: '%-d %B %Y' }}</time>
            </p>
            <h3>
              <a href="{{ episode.url | relative_url }}">{{ episode.title }}</a>
            </h3>
            <p>{{ episode.description }}</p>
            <a class="text-link home-podcast-link" href="{{ episode.url | relative_url }}">Watch, listen, and read the transcript</a>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="home-section" aria-labelledby="publications-title">
    <div class="section-heading">
      <h2 id="publications-title">Selected publications</h2>
      <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications</a>
    </div>
    <div class="featured-publications">
      {% for publication in page.featured_publications %}
        <article>
          <p class="publication-year">{{ publication.year }}</p>
          <div>
            <h3>
              <a href="{{ publication.url }}">{{ publication.title }}</a>
            </h3>
            <p class="publication-authors">{{ publication.authors }}</p>
            <p class="publication-venue-name">{{ publication.venue }}</p>
            <p class="publication-summary">{{ publication.summary }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section" aria-labelledby="talks-title">
    <div class="section-heading">
      <h2 id="talks-title">Selected invited talks</h2>
      <a class="text-link" href="{{ '/talks/' | relative_url }}">Talks archive</a>
    </div>
    <div class="selected-talks">
      {% for talk in page.featured_talks %}
        <article>
          <p class="talk-year">{{ talk.year }}</p>
          <div>
            <p class="talk-kind">{{ talk.kind }}</p>
            <h3>
              {% if talk.url %}<a href="{{ talk.url }}">{% endif -%}
              {{- talk.host -}}
              {%- if talk.url %}</a>{% endif %}
            </h3>
            <p class="talk-title">{{ talk.title }}</p>
            {% if talk.url -%}
              <a class="text-link talk-link" href="{{ talk.url }}">{{ talk.link_label }}</a>
            {%- endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  {% if site.announcements.enabled %}
    <section class="home-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <h2 id="latest-title">Research updates</h2>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <section class="home-section academic-contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <p>{{ site.contact_note }}</p>
    <p>
      <a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>
    </p>
  </section>
</article>

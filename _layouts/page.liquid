---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title | escape }}</h1>
    {% if page.show_description %}
      <p class="post-description">{{ page.description | escape }}</p>
    {% endif %}
  </header>
  <article>
    {{ content }}
  </article>
</div>
